<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- 🔥 TRUE FULL-SCREEN BACKGROUND VIDEO -->
    <VideoView
        android:id="@+id/backgroundVideo"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- UI container (NOT full screen) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="center"
        android:padding="16dp">

        <!-- Polaroid strip -->
        <LinearLayout
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/polaroid_strip_bg">

            <ImageView
                android:id="@+id/img1"
                style="@style/StripImage"
                android:contentDescription="@string/photo_slot" />

            <ImageView
                android:id="@+id/img2"
                style="@style/StripImage"
                android:contentDescription="@string/photo_slot" />

            <ImageView
                android:id="@+id/img3"
                style="@style/StripImage"
                android:contentDescription="@string/photo_slot" />

            <ImageView
                android:id="@+id/img4"
                style="@style/StripImage"
                android:contentDescription="@string/photo_slot" />
        </LinearLayout>

        <!-- Buttons -->
        <Button
            android:id="@+id/btnCamera"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:text="@string/capture_strip"
            android:layout_marginTop="16dp" />

        <Button
            android:id="@+id/btnGallery"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:text="@string/pick_from_gallery" />

        <Button
            android:id="@+id/btnShare"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:text="@string/share"
            android:enabled="false" />
    </LinearLayout>

</FrameLayout>
